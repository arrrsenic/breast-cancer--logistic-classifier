import warnings

import pandas as pd
import streamlit as st
from sklearn import datasets
from sklearn.exceptions import ConvergenceWarning
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (accuracy_score, confusion_matrix,
                             precision_recall_fscore_support)
from sklearn.model_selection import train_test_split

data = datasets.load_breast_cancer()
X, y = datasets.load_breast_cancer(return_X_y=True)

st.header("1. Data")
df = pd.DataFrame(X, columns=data.feature_names)
df["class"] = y 
st.write(f"INstances: {X.shape[0]} - Feature: {X.shape[1]}")
st.dataframe(df.head())

counts = pd.Series(y).map({0:"malignant (0)", 1: "benign (1)"}).value_counts() #trasformiamo e codifichiamo, contiamo quanti casi maligni e benigni ci sono nel set
st.bar_chart(counts)
st.write((counts / counts.sum()).round(3).rename("proportions"))

#splitting
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.30, stratify=y, random_state=42
)
st.header("2. Split 70/30")
st.write(f"Train: {len(X_train)} - Test: {len(X_test)}")

st.header("3. Training")

try:
    # If the algorithm is not able to find the solution within the default tries available an exception occurs. We set up the fallback.
    with warnings.catch_warnings():
        warnings.simplefilter("error", ConvergenceWarning)
        model = LogisticRegression()
        model.fit(X_train, y_train)
    st.write("Default parameters: OK")
except Exception as e:
    st.warning(f"Issue with default parameters ({type(e).__name__}); uso solver='liblinear'")
    model = LogisticRegression()
    model.fit(X_train, y_train) #learning
    
y_pred = model.predict(X_test)


st.header("4. Confusion matrix and metrics per class")
cm = confusion_matrix(y_test, y_pred, labels=[0, 1])
cm_df = pd.DataFrame(
    cm,
    index=["True malignant (0)", "True benign (1)"],
    columns=["Pred malignant (0)", "Pred benign (1)"],
)
st.dataframe(cm_df)
 
prec, rec, f1, support = precision_recall_fscore_support(
    y_test, y_pred, labels=[0, 1]
)
metrics = pd.DataFrame(
    {"precision": prec, "recall": rec, "f1-score": f1, "support": support},
    index=["malignant (0)", "benign (1)"],
)
st.dataframe(metrics.round(4))
 
best = metrics["f1-score"].idxmax()
st.success(f"Best-classified class: {best}")

 
